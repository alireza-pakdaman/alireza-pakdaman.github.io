---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import spaceGroteskUrl from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import monoUrl from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import { ClientRouter } from 'astro:transitions';
import { getCollection } from 'astro:content';
import { profile } from '../data/profile';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogSlug?: string;
}

const { title, description, ogSlug = 'site' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`/og/${ogSlug}.png`, Astro.site);

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => ({ slug: p.id, title: p.data.title, tagline: p.data.tagline }));

const siteData = {
  email: profile.email,
  github: profile.github,
  linkedin: profile.linkedin,
  resume: profile.resume,
  projects,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#faf9f7" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0d13" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Alireza Pakdaman" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" as="font" type="font/woff2" href={spaceGroteskUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={monoUrl} crossorigin />

    <script is:inline>
      (() => {
        const apply = () => {
          let t;
          try {
            t = localStorage.getItem('theme');
          } catch {}
          if (t !== 'light' && t !== 'dark') {
            t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.dataset.theme = t;
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>

    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="cursor-dot" aria-hidden="true" transition:persist="cursor-dot"></div>
    <div class="cursor-ring" aria-hidden="true" transition:persist="cursor-ring"></div>

    <header class="site-header">
      <nav class="site-nav container" aria-label="Main">
        <a class="brand" href="/" aria-label="Alireza Pakdaman — home">
          <span aria-hidden="true">ap<span class="brand-cursor">_</span></span>
        </a>
        <ul class="nav-links">
          <li><a href="/#projects">Work</a></li>
          <li><a href="/#experience">Experience</a></li>
          <li><a href="/playground">Playground</a></li>
        </ul>
        <div class="nav-actions">
          <button class="palette-btn" type="button" aria-label="Open command palette (Command K)">
            <kbd>⌘K</kbd>
          </button>
          <button class="theme-toggle" type="button" aria-label="Toggle color theme">
            <svg class="icon-sun" aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="12" cy="12" r="4.4"></circle>
              <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8"></path>
            </svg>
            <svg class="icon-moon" aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
            </svg>
          </button>
          <a class="btn nav-resume" href="/resume.pdf" data-magnetic>Resume</a>
        </div>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <p class="footer-name">Alireza Pakdaman</p>
          <p class="footer-note">Software engineer · Greater Toronto Area</p>
        </div>
        <ul class="footer-links">
          <li><a href={`mailto:${profile.email}`}>Email</a></li>
          <li><a href={profile.github} target="_blank" rel="noopener">GitHub</a></li>
          <li><a href={profile.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
          <li><a href="/resume.pdf">Resume</a></li>
        </ul>
        <p class="footer-hint">
          <button class="terminal-btn" type="button">
            <span class="term-glyph" aria-hidden="true">&gt;_</span> open terminal
          </button>
          <span class="footer-kbd" aria-hidden="true">or press <kbd>&gt;</kbd> · <kbd>⌘K</kbd> to navigate</span>
        </p>
      </div>
      <div class="container footer-fineprint">
        <p>© 2026 Alireza Pakdaman · Built with Astro · No trackers, no cookies</p>
      </div>
    </footer>

    <div id="live-region" class="visually-hidden" role="status" aria-live="polite"></div>
    <script type="application/json" id="site-data" set:html={JSON.stringify(siteData)} is:inline />

    <dialog id="cmdk" class="cmdk" aria-label="Command palette" transition:persist="cmdk">
      <div class="cmdk-frame">
        <input
          id="cmdk-input"
          type="text"
          placeholder="Type a command or search…"
          role="combobox"
          aria-expanded="true"
          aria-controls="cmdk-list"
          aria-autocomplete="list"
          autocomplete="off"
          spellcheck="false"
        />
        <ul id="cmdk-list" role="listbox" aria-label="Commands"></ul>
        <p class="cmdk-hint" aria-hidden="true"><kbd>↑↓</kbd> navigate <kbd>↵</kbd> run <kbd>esc</kbd> close</p>
      </div>
    </dialog>

    <dialog id="terminal" class="terminal" aria-label="Terminal" transition:persist="terminal">
      <div class="term-frame">
        <div class="term-titlebar">
          <span class="term-lights" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="term-title">visitor@alirezapakdaman — zsh</span>
          <button class="term-close" type="button" aria-label="Close terminal">✕</button>
        </div>
        <div id="term-out" class="term-out" role="log" aria-live="polite"></div>
        <form id="term-form" class="term-line">
          <label for="term-in" class="term-prompt" aria-hidden="true">visitor@alirezapakdaman:~$</label>
          <input id="term-in" autocomplete="off" autocapitalize="off" spellcheck="false" aria-label="Terminal command input" />
        </form>
      </div>
    </dialog>

    <script src="../scripts/main.ts"></script>
  </body>
</html>

<style is:global>
  /* ------------------------------------------------------------- header */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-block: 0.7rem;
  }

  .brand {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .brand-cursor {
    color: var(--accent);
    animation: blink 1.2s steps(2) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .nav-links {
    display: flex;
    gap: 1.4rem;
    list-style: none;
    margin: 0 auto 0 0;
    padding: 0;
  }

  .nav-links a {
    color: var(--ink-2);
    text-decoration: none;
    font-size: 0.95rem;
    font-family: var(--font-display);
    font-weight: 500;
  }

  .nav-links a:hover {
    color: var(--ink);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-left: auto;
  }

  .palette-btn,
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 34px;
    min-width: 34px;
    padding: 0 0.45rem;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
  }

  .palette-btn:hover,
  .theme-toggle:hover {
    border-color: var(--accent);
    color: var(--ink);
    background: var(--accent-soft);
  }

  .palette-btn kbd {
    border: 0;
    background: none;
    padding: 0;
    font-size: 0.78rem;
    color: inherit;
  }

  .theme-toggle .icon-moon {
    display: none;
  }

  [data-theme='dark'] .theme-toggle .icon-moon {
    display: block;
  }

  [data-theme='dark'] .theme-toggle .icon-sun {
    display: none;
  }

  .nav-resume {
    padding: 0.42rem 0.95rem;
    font-size: 0.88rem;
    border-radius: 9px;
  }

  @media (max-width: 640px) {
    .nav-links {
      display: none;
    }

    .palette-btn {
      display: none;
    }
  }

  /* ------------------------------------------------------------- footer */
  .site-footer {
    border-top: 1px solid var(--line);
    margin-top: 4rem;
    background: var(--bg-inset);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 2rem;
    align-items: center;
    padding-block: 2.2rem 1.2rem;
  }

  .footer-name {
    font-family: var(--font-display);
    font-weight: 600;
    margin: 0;
  }

  .footer-note {
    color: var(--ink-2);
    font-size: 0.9rem;
    margin: 0;
  }

  .footer-links {
    display: flex;
    gap: 1.2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-links a {
    color: var(--ink-2);
    font-size: 0.92rem;
  }

  .footer-hint {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    align-items: flex-end;
  }

  .terminal-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border: 1px dashed var(--line);
    border-radius: 8px;
    background: transparent;
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    padding: 0.35rem 0.7rem;
    cursor: pointer;
  }

  .terminal-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .term-glyph {
    color: var(--accent);
    font-weight: 700;
  }

  .footer-kbd {
    color: var(--ink-3-solid);
    font-size: 0.75rem;
  }

  .footer-fineprint {
    border-top: 1px solid var(--line);
    padding-block: 1rem;
  }

  .footer-fineprint p {
    margin: 0;
    color: var(--ink-3-solid);
    font-size: 0.8rem;
    font-family: var(--font-mono);
  }

  @media (max-width: 720px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 1.2rem;
    }

    .footer-hint {
      align-items: flex-start;
    }
  }

  /* ------------------------------------------------------ command palette */
  .cmdk {
    width: min(92vw, 34rem);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 0;
    background: var(--bg-raised);
    color: var(--ink);
    box-shadow: var(--card-shadow-hover);
    margin: 12vh auto auto;
  }

  .cmdk::backdrop {
    background: rgba(8, 10, 16, 0.45);
    backdrop-filter: blur(3px);
  }

  .cmdk-frame {
    display: flex;
    flex-direction: column;
  }

  #cmdk-input {
    border: 0;
    border-bottom: 1px solid var(--line);
    background: transparent;
    color: var(--ink);
    font: 500 1rem var(--font-display);
    padding: 0.95rem 1.1rem;
    outline: none;
  }

  #cmdk-list {
    list-style: none;
    margin: 0;
    padding: 0.45rem;
    max-height: 46vh;
    overflow-y: auto;
  }

  .cmdk-group {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-3-solid);
    padding: 0.6rem 0.7rem 0.25rem;
  }

  .cmdk-item {
    padding: 0.55rem 0.7rem;
    border-radius: 8px;
    cursor: pointer;
    font-size: 0.95rem;
    color: var(--ink-2);
  }

  .cmdk-item.is-selected {
    background: var(--accent-soft);
    color: var(--ink);
    box-shadow: inset 2px 0 0 var(--accent);
  }

  .cmdk-empty {
    padding: 1rem 0.7rem;
    color: var(--ink-3-solid);
    font-size: 0.9rem;
  }

  .cmdk-hint {
    margin: 0;
    padding: 0.55rem 1.1rem;
    border-top: 1px solid var(--line);
    color: var(--ink-3-solid);
    font-size: 0.75rem;
  }

  /* --------------------------------------------------------- terminal */
  .terminal {
    width: min(94vw, 42rem);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0;
    background: #0b0f16;
    color: #d7e0d9;
    box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.7);
    margin: auto;
  }

  .terminal::backdrop {
    background: rgba(8, 10, 16, 0.55);
    backdrop-filter: blur(3px);
  }

  .term-frame {
    display: flex;
    flex-direction: column;
    height: min(60vh, 26rem);
  }

  .term-titlebar {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.55rem 0.8rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .term-lights {
    display: inline-flex;
    gap: 0.35rem;
  }

  .term-lights i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #ff5f57;
  }

  .term-lights i:nth-child(2) {
    background: #febc2e;
  }

  .term-lights i:nth-child(3) {
    background: #28c840;
  }

  .term-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: rgba(215, 224, 217, 0.6);
    margin-inline: auto;
  }

  .term-close {
    border: 0;
    background: transparent;
    color: rgba(215, 224, 217, 0.6);
    cursor: pointer;
    font-size: 0.85rem;
    padding: 0.15rem 0.35rem;
    border-radius: 6px;
  }

  .term-close:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.1);
  }

  .term-out {
    flex: 1;
    overflow-y: auto;
    padding: 0.9rem 1rem 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.83rem;
    line-height: 1.55;
  }

  .term-row {
    white-space: pre-wrap;
    word-break: break-word;
  }

  .term-row a {
    color: #3ecf8e;
  }

  .term-echo {
    color: rgba(215, 224, 217, 0.55);
  }

  .term-ok {
    color: #3ecf8e;
  }

  .term-err {
    color: #ff6b6b;
  }

  .term-line {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 1rem 0.9rem;
  }

  .term-prompt {
    font-family: var(--font-mono);
    font-size: 0.83rem;
    color: #3ecf8e;
    white-space: nowrap;
  }

  #term-in {
    flex: 1;
    border: 0;
    background: transparent;
    color: #d7e0d9;
    font-family: var(--font-mono);
    font-size: 0.83rem;
    outline: none;
    caret-color: #3ecf8e;
  }
</style>
